# ==============================================================================
# EcoPulse Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL 14+ / Neon Serverless Postgres)
# Local: postgres://gurukantpatil@localhost:5432/ecopulse
# Neon:  postgresql://<username>:<password>@<ep-project-id>.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://gurukantpatil@localhost:5432/ecopulse

# JWT Authentication (at least 32 characters in production)
JWT_SECRET=super_secret_local_dev_jwt_key_replace_in_prod_at_least_32_chars_long

# AI Provider ('mock' or 'bedrock')
AI_PROVIDER=mock

# Storage Provider ('local' or 's3')
STORAGE_PROVIDER=local

# Job Queue Provider ('memory' or 'sqs')
QUEUE_PROVIDER=memory

# Mobile App API endpoint (for Expo)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional AWS Settings (for production Bedrock, S3, SQS)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=ecopulse-evidence
# AWS_SQS_QUEUE_URL=
# AWS_BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0
