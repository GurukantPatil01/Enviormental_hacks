# ==============================================================================
# EcoPulse Environment Configuration
# ==============================================================================

# Application Environment Mode ('local' or 'aws')
APP_ENV=local

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL with PostGIS and pgvector)
# Local: postgres://gurukantpatil@localhost:5432/ecopulse
DATABASE_URL=postgres://gurukantpatil@localhost:5432/ecopulse

# JWT Authentication (at least 32 characters in production)
JWT_SECRET=super_secret_local_dev_jwt_key_replace_in_prod_at_least_32_chars_long

# Provider Abstractions ('local', 'mock', or cloud providers)
STORAGE_PROVIDER=local       # 'local' or 's3'
EVENT_BUS_PROVIDER=local     # 'local' or 'eventbridge'
AI_PROVIDER=mock             # 'mock', 'local', or 'bedrock'
EMBEDDING_PROVIDER=mock      # 'mock', 'local', or 'bedrock'
OBSERVABILITY_PROVIDER=local # 'local' or 'cloudwatch'

# Hotspot Algorithm Configuration
HOTSPOT_RADIUS_METERS=150
HOTSPOT_MIN_REPORTS=2
HOTSPOT_TIME_WINDOW_DAYS=30
HOTSPOT_ESCALATION_THRESHOLD=50

# Mobile App API Endpoint (for Expo client)
EXPO_PUBLIC_API_URL=http://localhost:4000

# ==============================================================================
# Optional AWS Settings (When APP_ENV=aws)
# ==============================================================================
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=ecopulse-evidence-dev
# S3_BUCKET_NAME=ecopulse-storage-dev
# EVENT_BUS_NAME=ecopulse-events-dev
# BEDROCK_VISION_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1
