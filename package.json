{
  "name": "ecopulse",
  "version": "0.1.0",
  "private": true,
  "description": "EcoPulse — Environmental Community Accountability and Incentivization Platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @ecopulse/api db:migrate",
    "db:seed": "pnpm --filter @ecopulse/api db:seed",
    "db:check": "pnpm --filter @ecopulse/api db:check",
    "s3:check": "pnpm --filter @ecopulse/api s3:check",
    "s3:sync": "pnpm --filter @ecopulse/api exec tsx ../../scripts/sync-to-s3.ts",
    "db:clear-reports": "pnpm --filter @ecopulse/api exec tsx ../../scripts/clear-reports.ts",
    "seed:environmental": "pnpm --filter @ecopulse/api exec tsx ../../scripts/seed/environmental-demo.ts"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.18.0"
}
