{
  "name": "@ecopulse/api",
  "version": "0.1.0",
  "private": true,
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --fileParallelism=false",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'api lint passed'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:check": "tsx src/db/check-connection.ts",
    "s3:check": "tsx ../../scripts/check-s3.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1147.0",
    "@aws-sdk/client-cloudwatch": "^3.1147.0",
    "@aws-sdk/client-eventbridge": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@ecopulse/config": "workspace:*",
    "@ecopulse/types": "workspace:*",
    "@ecopulse/validation": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@google/genai": "^2.28.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
